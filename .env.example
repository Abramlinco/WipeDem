# Copy this file to .env and fill in your own values. Never commit the real .env file.

# ---- Telegram (optional, leave blank to run Discord only) ----
# From @BotFather.
TELEGRAM_BOT_TOKEN=

# ---- Discord (optional, leave blank to run Telegram only) ----
# Bot token: Developer Portal > your application > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# For "Continue with Discord" sign in: Developer Portal > OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Dashboard ----
PORT=3000
# 127.0.0.1 keeps the dashboard reachable only from this computer.
# Use 0.0.0.0 only when you deploy it somewhere on purpose.
HOST=127.0.0.1
# Where people open the dashboard. When you deploy, change this to your real address.
# Discord sign in needs {PUBLIC_URL}/auth/discord/callback added as a Redirect in the Developer Portal.
PUBLIC_URL=http://localhost:3000

# ---- Pulse (community ideas, market trends, campaign playbook) ----
# Set to false to switch the trend feeder off. Chat reading is controlled per community in Settings.
PULSE_ENABLED=true
# How often the feeder reads the web, in minutes (10 or more).
PULSE_REFRESH_MINUTES=30
# How long stored community messages are kept, in days (1 to 90).
PULSE_RETENTION_DAYS=30
# Optional. Lets Pulse read X. Needs a paid X API plan that includes recent search.
X_BEARER_TOKEN=

# ---- Reply drafting (the Draft button in Pulse) ----
# With nothing below filled in, Pulse uses its built in drafter: free, no AI,
# fills templates from your Project Brief and the latest stories.
# To use an AI model instead, fill in ONE of the two options.
#
# Option A, free or cheap: any service that uses the common "chat completions" format.
# Examples (check each service's current free limits and data terms before relying on it):
#   Google Gemini   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq            AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter      AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama (on your own computer, nothing leaves it)  AI_BASE_URL=http://localhost:11434/v1
# Free tiers may keep or learn from what you send. Member messages and your Project Brief are sent to it.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
#
# Option B, paid, when you are ready: Claude.
ANTHROPIC_API_KEY=
# Optional. The default is the small, low cost model.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#
# Optional. Force one engine: none, openai or anthropic.
AI_PROVIDER=
# Cost protection: most drafts one community may ask for per hour (5 to 1000).
DRAFTS_PER_HOUR=60

# ---- Pulse testing aids (leave off in normal use) ----
# Prints, for every message, whether Pulse kept it or why it skipped it.
PULSE_DEBUG=false
# Pulse normally ignores admins and owners. Set true to test with your own admin account.
PULSE_CAPTURE_STAFF=false

# ---- X (Twitter), pools and posting ----
# X reading: set X_BEARER_TOKEN (above). X charges per post read, so Sentinel keeps a monthly limit.
# Estimated spend is tracked and X is not read once the limit is reached. 0 switches X reading off.
X_MONTHLY_BUDGET_USD=10
# How often X is read, in hours (1 to 72). X is read less often than other feeds to protect the limit.
X_REFRESH_HOURS=12
# Set to false to read only the accounts and searches each community adds itself.
X_DEFAULT_FEEDS=true
# Needed to connect an X account for posting. Used to encrypt the keys before they are saved.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe and never change it, or saved X keys can no longer be opened.
SENTINEL_SECRET=
# How often watched pools are checked, in minutes (10 or more).
POOL_REFRESH_MINUTES=20


# Optional X account authorization (OAuth 2.0 with PKCE). Register this exact callback URL in the X Developer Portal.
# X_OAUTH_REDIRECT_URI should be PUBLIC_URL/auth/x/callback unless your deployment requires a different public URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_OAUTH_REDIRECT_URI=https://your-domain.example/auth/x/callback

# The watcher reads every connected community on its own: it drafts FAQs for questions the facts do not cover
# and sends scheduled Technical Push reports. Set PULSE_WATCH=false to turn it off.
# PULSE_WATCH=true
# PULSE_WATCH_MINUTES=30

# FAQs Intelligence: how many times a question must be asked before it becomes an FAQ draft (1 = every question your documents do not cover).
FAQ_MIN_ASKS=1
# How many AI proposed answers one scan may request (protects free tier limits). 0 turns AI proposals off.
FAQ_AI_PER_SCAN=8
