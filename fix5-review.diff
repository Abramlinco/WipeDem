diff -ruN '--exclude=*.bak*' '--exclude=*.patch' '--exclude=apply-*.mjs' '--exclude=*.before-*' a/test/fix5.test.js b/test/fix5.test.js
--- a/test/fix5.test.js	1970-01-01 00:00:00.000000000 +0000
+++ b/test/fix5.test.js	2026-10-20 06:59:17.760216268 +0000
@@ -0,0 +1,57 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { analyze } from '../src/pulse/analyze.js';
+import { isCandidate, isTechnicalIssue, answersFor, usableAnswer, reportersOf } from '../src/pulse/faqlogic.js';
+import { parsePoolInput } from '../src/pulse/pools.js';
+
+// fix-5 tests. No database and no network needed.
+const asRow = (text) => { const a = analyze(text); return a ? { text, ...a } : null; };
+
+test("harmless can't phrases are not problems", () => {
+  for (const t of ["I can't wait for mainnet to launch!!", "gm fam can't believe how fast the chain is growing", "I'm missing out on the rewards because I was away"]) {
+    const r = asRow(t);
+    assert.ok(!r || r.kind !== 'concern', t);
+    assert.ok(!r || !isTechnicalIssue(r), t);
+  }
+});
+
+test('price chatter and secret-phrase requests never become FAQ candidates', () => {
+  assert.equal(isCandidate({ kind: 'question', text: 'wen moon bro price is so low' }), false);
+  assert.equal(isCandidate({ kind: 'concern', text: 'support said send your seed phrase to fix the wallet error' }), false);
+  assert.equal(isTechnicalIssue({ kind: 'concern', text: 'support said send your seed phrase to fix the wallet error', topics: ['wallet'] }), false);
+  assert.equal(isCandidate({ kind: 'question', text: 'How long does unstaking take?' }), true);
+});
+
+test('Keplr and Kepler wallet problems are kept and reported as technical issues', () => {
+  for (const t of ["my keplr won't sign the transaction", 'Kepler wallet shows wrong balance after unstake', 'claim button does nothing, tx pending for 3 hours', 'Keplr is not connecting to the dapp']) {
+    const r = asRow(t);
+    assert.equal(r?.kind, 'concern', t);
+    assert.ok(isTechnicalIssue(r), t);
+    if (/keplr|kepler/i.test(t)) assert.ok((r.topics || []).includes('wallet'), t);
+  }
+});
+
+test('thanks, lol and DM me are not moderator answers', () => {
+  assert.equal(usableAnswer('lol'), false);
+  assert.equal(usableAnswer('Thanks!'), false);
+  assert.equal(usableAnswer('dm me and I will help you out'), false);
+  assert.equal(usableAnswer('Unstaking takes about 21 days.'), true);
+  const row = { text: 'How long does unstaking take?', staffReplies: [{ text: 'lol' }, { text: 'check your dms' }, { text: 'Unstaking takes about 21 days.' }] };
+  assert.deepEqual(answersFor({ rep: row, items: [row] }), ['Unstaking takes about 21 days.']);
+});
+
+test('one member asking twice is one member', () => {
+  assert.equal(reportersOf([{ userId: 'a' }, { userId: 'a' }]), 1);
+  assert.equal(reportersOf([{ userId: 'a' }, { userId: 'b' }]), 2);
+});
+
+test('pool links: Osmosis works, a 64 character address is never cut into an EVM one', () => {
+  const P = (input, extra = {}) => parsePoolInput({ mode: 'pool', input, ...extra });
+  assert.deepEqual(P('https://app.osmosis.zone/pool/3505'), { ok: true, kind: 'pair', chain: 'osmosis', address: '3505' });
+  assert.deepEqual(P('https://www.mintscan.io/osmosis/pool/3505'), { ok: true, kind: 'pair', chain: 'osmosis', address: '3505' });
+  const sui = '0x' + 'a'.repeat(64);
+  assert.equal(P('https://suiscan.xyz/mainnet/object/' + sui).ok, false, 'without the chain it asks instead of guessing');
+  assert.deepEqual(P('https://suiscan.xyz/mainnet/object/' + sui, { chain: 'sui' }), { ok: true, kind: 'pair', chain: 'sui', address: sui });
+  assert.deepEqual(P(sui, { chain: 'sui' }), { ok: true, kind: 'pair', chain: 'sui', address: sui });
+  assert.match(P('0x123', { chain: 'bsc' }).error, /does not look right/);
+});
