'use strict';

/* =====================================================================
   Pulse: community ideas, market trends and the campaign playbook.
   Loaded before app.js. Everything here runs only when a page asks for
   it, and it uses the same helpers as the rest of the dashboard (html``
   escapes anything that came from outside, so a message full of HTML
   cannot run code).
===================================================================== */
const pulseState = { setup: 'brief', kind: 'all', topic: '', showDone: false, space: 'all', days: 7 };

const P_KIND = { idea: 'Idea', question: 'Question', concern: 'Concern', praise: 'Praise', discussion: 'Discussion' };
// Only things that need attention get a colour: concerns, and (below) unanswered questions.
const P_KIND_CLS = { idea: 'info', question: '', concern: 'net', praise: '', discussion: '' };
const P_SPACE = { web3: 'Web3', traditional: 'Traditional', social: 'Social' };
// A confirm pop-up in the same style as the rest of the dashboard, instead of the browser's plain one.
function askConfirm(title, body, okLabel = 'Confirm') {
  return new Promise((resolve) => {
    const box = document.createElement('div');
    box.className = 'overlay';
    box.style.zIndex = '60';
    box.innerHTML = html`<aside class="drawer modal confirm" role="alertdialog" aria-label="${title}">
        <h3>${title}</h3><p class="muted" style="margin:8px 0 18px">${body}</p>
        <div style="display:flex;gap:8px;justify-content:flex-end"><button class="btn" data-c="0">Cancel</button><button class="btn primary" data-c="1">${okLabel}</button></div>
      </aside>`.s;
    const onKey = (e) => { if (e.key === 'Escape') { e.stopPropagation(); finish(false); } };
    const finish = (v) => { document.removeEventListener('keydown', onKey, true); box.remove(); resolve(v); };
    box.addEventListener('click', (e) => {
      const b = e.target.closest('[data-c]');
      if (b) finish(b.dataset.c === '1'); else if (e.target === box) finish(false);
    });
    document.addEventListener('keydown', onKey, true); // runs before the page's own Escape handling
    document.body.appendChild(box);
    box.querySelector('[data-c="1"]').focus();
  });
}

const safeUrl = (u) => (/^https?:\/\//i.test(u || '') ? u : '#');

async function loadPulse(sub) {
  const tab = sub === 'brief' ? 'setup' : (['ideas', 'trends', 'pools', 'playbook', 'setup'].includes(sub) ? sub : 'ideas');
  if (!state.me.communities.length) {
    return setPage(html`<div class="topbar"><h1>Pulse</h1></div>${onboarding(null)}`);
  }
  const community = state.scope === 'all' ? undefined : state.scope;
  const tabBtn = (id, label) => html`<button class="${tab === id ? 'active' : ''}" data-nav="#/pulse/${id}">${label}</button>`;
  const head = html`<div class="topbar"><h1>Pulse</h1><div class="tools">
      ${scopeSelect(null)}
      <select data-pulse-change="days" aria-label="Time range">
        ${[[1, 'Last 24 hours'], [7, 'Last 7 days'], [14, 'Last 14 days'], [30, 'Last 30 days']].map(([n, l]) => html`<option value="${n}" ${pulseState.days === n ? 'selected' : ''}>${l}</option>`)}
      </select></div></div>
    <div class="tabs">${tabBtn('ideas', 'Ideas')}${tabBtn('trends', 'Market trends')}${tabBtn('pools', 'Pools')}${tabBtn('playbook', 'Playbook')}${tabBtn('setup', 'Setup')}</div>`;
  const body = tab === 'ideas' ? await pulseIdeas(community)
    : tab === 'trends' ? await pulseTrends(community)
    : tab === 'pools' ? await pulsePools(community)
    : tab === 'setup' ? await pulseSetup()
    : await pulsePlaybook(community);
  setPage(html`${head}${body}`);
}

