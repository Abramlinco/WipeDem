    <div class="pbtns"><button class="btn primary" data-pulse="post-go">Post</button><button class="btn" data-pulse="post-copy">Copy</button></div>`);
}

function updatePostCount() {
  const el = $('#post-count');
  if (!el) return;
  const t = $('#post-text')?.value || '';
  const x = $('#post-x')?.value || 'none';
  const n = [...t.replace(/https?:\/\/\S+/gi, 'x'.repeat(23))].length;
  let msg = `${t.length} characters.`;
  if (x !== 'none') msg += ` On X it counts as ${n} of 280${n > 280 ? ', which is too long for X' : ''}.`;
  if (x.startsWith('api:')) msg += ` Posting through your X account costs about ${/https?:\/\/\S+/i.test(t) ? '$0.20, because it has a link' : '$0.015'}.`;
  el.textContent = msg;
}

