let postCtx = null; // { sources, channels, x }

async function openPost(text, sources = []) {
  const comms = state.me.communities;
  $('#drawer-root').innerHTML = modalShell('Post…', html`<p class="muted">Loading your communities…</p>`).s;
  const [chan, xs] = await Promise.all([
    Promise.all(comms.filter((c) => c.platform === 'discord').map(async (c) => [c.key, await api(`/pulse/channels/discord/${enc(c.id)}`).catch(() => [])])),
    Promise.all(comms.map(async (c) => [c.key, await api(`/pulse/x/${c.platform}/${enc(c.id)}`).catch(() => null)]))
  ]);
  postCtx = { sources, channels: Object.fromEntries(chan), x: Object.fromEntries(xs) };
  $('#drawer-root').innerHTML = postPanel(text).s;
  updatePostCount();
}

function postPanel(text) {
  const comms = state.me.communities;
  const dest = comms.map((c) => {
    const ch = postCtx.channels[c.key] || [];
    const can = c.platform === 'telegram' || ch.length > 0;
    return html`<div class="postdest"><label class="chk"><input type="checkbox" data-post-target="${c.key}" ${can ? '' : 'disabled'}><span class="plat ${c.platform}">${CODE[c.platform]}</span>${c.name}</label>
      ${c.platform === 'discord' && (ch.length ? html`<select data-post-channel="${c.key}">${ch.map((x) => html`<option value="${x.id}">#${x.name}</option>`)}</select>` : html`<span class="muted">The bot has no channel it can write in</span>`)}</div>`;
  });
  const xOpts = comms.filter((c) => postCtx.x[c.key]?.account?.connected).map((c) => html`<option value="api:${c.key}">Post to X as @${postCtx.x[c.key].account.handle} (${c.name})</option>`);
  return modalShell('Post…', html`
