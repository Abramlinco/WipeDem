function sourceStatus(s) {
  if (s.needsKey) return html`<span class="tag">Needs X key</span>`;
  if (!s.status) return html`<span class="tag">Not read yet</span>`;
  return s.status.ok
    ? html`<span class="tag ok">OK · ${s.status.count} stories</span>`
    : html`<span class="tag bad" title="${s.status.error}">Failing</span>`;
}

async function pulseTrends(community) {
  const [trends, src] = await Promise.all([
    api(`/pulse/trends${qs({ community, days: pulseState.days, space: pulseState.space === 'all' ? undefined : pulseState.space })}`),
    api(`/pulse/sources${qs({ community })}`)
  ]);
  const spaceTab = (id, label) => html`<button class="${pulseState.space === id ? 'active' : ''}" data-pulse="space" data-space="${id}">${label}</button>`;
  const failing = src.sources.filter((s) => s.status && !s.status.ok).length;
  return html`
    <div class="tabs filters">${spaceTab('all', 'Everything')}${spaceTab('web3', 'Web3 and crypto')}${spaceTab('traditional', 'Traditional')}${spaceTab('social', 'Social')}</div>
    <div class="panel"><h2>What is moving outside your community
      <span>${src.lastRefresh ? `feeds read ${ago(src.lastRefresh)}` : (src.feederOn ? 'first read is on its way' : 'feeder is switched off')}
        <button class="btn" data-pulse="refresh" style="margin-left:8px">Refresh now</button></span></h2>
      ${trends.length ? trends.map((t) => html`<div class="row static"><div class="rowmain">
          <div class="who"><a href="${safeUrl(t.url)}" target="_blank" rel="noopener noreferrer">${t.title}</a></div>
          ${t.summary && html`<div class="ptxt">${t.summary}</div>`}
          <div class="pmeta"><span class="tag">${t.source}</span> <span class="tag">${P_SPACE[t.space] || t.space}</span>
            ${t.own && html`<span class="tag info">Your feed</span>`} ${ago(t.publishedAt)}
            ${t.matchedTopics.length > 0 && html` <span class="tag net">Your community is also discussing: ${t.matchedTopics.join(', ')}</span>`}</div>
        </div></div>`)
        : html`<div class="empty"><b>No stories yet</b><br>${src.feederOn ? 'The feeds are read every half hour. Press Refresh now to read them straight away.' : 'The trend feeder is switched off in your settings file.'}</div>`}
    </div>
    <div class="panel"><h2>Sources <span>${failing ? `${failing} failing` : 'all reachable so far'}</span></h2>
      ${src.sources.map((s) => {
        const [plat, ...rest] = (s.ownerKey || '').split(':');
        const tail = s.id.slice(s.id.indexOf('|') + 1);        // "reddit:solana"
        const srcType = tail.split(':')[0], srcValue = tail.slice(srcType.length + 1);
        return html`<div class="row static"><div class="rowmain"><div class="who">${s.label}${s.custom && html` <span class="tag info">Added by you</span>`}</div>
          ${s.status && !s.status.ok && html`<div class="txt">${s.status.error}</div>`}</div>
          ${sourceStatus(s)}
          ${s.custom && html`<button class="btn ban" data-pulse="src-del" data-platform="${plat}" data-community="${rest.join(':')}" data-type="${srcType}" data-value="${srcValue}">Remove</button>`}</div>`;
      })}
      <div class="pad"><b>Add your own source</b>
        <div class="srcform">
          <select id="src-community">${communitiesOf(null).map((c) => html`<option value="${c.key}">${CODE[c.platform]} · ${c.name}</option>`)}</select>
          <select id="src-type"><option value="reddit">Subreddit</option><option value="rss">RSS feed</option><option value="xaccount">X account${src.xConnected ? '' : ' (needs key)'}</option><option value="x">X search${src.xConnected ? '' : ' (needs key)'}</option></select>
          <input id="src-value" placeholder="e.g. solana, or https://site.com/feed">
          <button class="btn primary" data-pulse="src-add">Add</button>
        </div>
        <div class="muted" style="margin-top:6px">Only your community sees feeds you add. RSS addresses must be public https links.</div></div>
    </div>`;
}

