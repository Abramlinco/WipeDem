const reloadPulse = () => loadPulse(route().sub).catch(fail);

// Adds a knowledge source and says plainly whether it could be read. Web and DefiLlama sources can take a few seconds.
async function addKnowledge(el, body) {
  const label = el.textContent;
  el.disabled = true; el.textContent = 'Reading…';
  try {
    const r = await api(`/pulse/knowledge/${el.dataset.platform}/${enc(el.dataset.community)}`, { method: 'POST', body });
    if (r.result.ok) toast(`Added. ${r.source.chunkCount} ${r.source.chunkCount === 1 ? 'section' : 'sections'} read.`);
    else toast(`Added, but it could not be read: ${r.result.error}`, true);
    return await reloadPulse();
  } finally { el.disabled = false; el.textContent = label; }
}

const PULSE_ACTS = {
  kind: (el) => { pulseState.kind = el.dataset.kind; return reloadPulse(); },
  topic: (el) => { pulseState.topic = el.dataset.topic; return reloadPulse(); },
  space: (el) => { pulseState.space = el.dataset.space; return reloadPulse(); },
  status: async (el) => {
    el.disabled = true;
    await api(`/pulse/discussions/${enc(el.dataset.id)}/status`, { method: 'POST', body: { status: el.dataset.status } });
    return reloadPulse();
  },
  refresh: async (el) => {
    el.disabled = true; el.textContent = 'Reading feeds…';
    try {
      const r = await api('/pulse/refresh', { method: 'POST' });
      toast(`${r.added} new ${r.added === 1 ? 'story' : 'stories'}${r.failed ? `, ${r.failed} source${r.failed === 1 ? '' : 's'} failed` : ''}`);
    } finally { await reloadPulse(); }
  },
  copy: async (el) => {
    try { await navigator.clipboard.writeText($(`#pd-${el.dataset.i}`).value); toast('Draft copied'); }
    catch { toast('Could not copy. Select the text and copy it manually.', true); }
  },
  enabled: async (el) => {
    await api(`/pulse/enabled/${el.dataset.platform}/${enc(el.dataset.community)}`, { method: 'POST', body: { enabled: !el.dataset.on } });
    return reloadPulse();
  },
  'src-add': async () => {
    const [platform, ...rest] = $('#src-community').value.split(':');
    await api(`/pulse/sources/${platform}/${enc(rest.join(':'))}`, { method: 'POST', body: { type: $('#src-type').value, value: $('#src-value').value } });
    toast('Source added. It is read on the next refresh.');
    return reloadPulse();
  },
  draft: async (el) => {
    const id = el.dataset.id;
    $('#drawer-root').innerHTML = modalShell('Drafting a reply…', html`<p class="muted">Reading the message, your brief and the latest stories…</p>`).s;
    try {
      const d = await api(`/pulse/discussions/${enc(id)}/draft`, { method: 'POST', body: { fresh: el.dataset.fresh === '1' } });
      $('#drawer-root').innerHTML = draftPanel(id, d).s;
    } catch (e) { closeProfile(); throw e; }
  },
  'copy-draft': async () => {
    try { await navigator.clipboard.writeText($('#draft-text').value); toast('Reply copied'); }
    catch { toast('Could not copy. Select the text and copy it manually.', true); }
  },
  'send-draft': async (el) => {
    const text = $('#draft-text').value.trim();
    if (!text) return toast('The reply is empty', true);
    if (!(await askConfirm('Post this reply?', `It will appear in the chat as a reply to ${currentDraft.to}, from the bot.`, 'Post reply'))) return;
    el.disabled = true;
    try {
      await api(`/pulse/discussions/${enc(currentDraft.id)}/send`, { method: 'POST', body: { text, approved: true, sources: currentDraft.sources } });
      toast('Reply posted');
      closeProfile();
      return reloadPulse();
