function pulseRow(d) {
  const open = d.kind === 'question' && !d.staffReplied && !d.replies;
  const btn = (status, label, kind = '') => html`<button class="btn ${kind}" data-pulse="status" data-id="${d.id}" data-status="${status}">${label}</button>`;
  return html`<div class="row static">
    <div class="rowmain">
      <div class="who">${d.username}
        <span class="tag ${P_KIND_CLS[d.kind]}">${P_KIND[d.kind]}</span>
        ${d.status === 'starred' && html`<span class="tag">Starred</span>`}
        ${d.status === 'done' && html`<span class="tag ok">Done</span>`}
        ${d.replied && html`<span class="tag ok">Replied from Sentinel</span>`}
        ${d.draftReady && html`<span class="tag info">Draft ready</span>`}
        ${open && !d.replied && html`<span class="tag bad">Unanswered</span>`}
        ${d.replies > 0 && html`<span class="tag">${d.replies} ${d.replies === 1 ? 'reply' : 'replies'}</span>`}</div>
      <div class="ptxt">${d.text}</div>
      <div class="pmeta">${d.communityName}${d.channelName && d.channelName !== d.communityName ? ` · #${d.channelName}` : ''} · ${ago(d.createdAt)}
        ${d.topics.slice(0, 3).map((t) => html` <button class="chip sm" data-pulse="topic" data-topic="${t}">${t}</button>`)}
        ${d.link && html` <a class="nowrap" href="${d.link}" target="_blank" rel="noopener noreferrer">Open in chat ↗</a>`}</div>
    </div>
    <div class="actions">
      ${!d.replied && html`<button class="btn primary" data-pulse="draft" data-id="${d.id}">${d.draftReady ? 'Review draft' : 'Draft reply'}</button>`}
      ${d.status === 'starred' ? btn('new', 'Unstar') : btn('starred', 'Star')}
      ${d.status === 'done' ? btn('new', 'Reopen') : btn('done', 'Done')}
      ${d.status !== 'dismissed' && btn('dismissed', 'Dismiss')}
    </div>
  </div>`;
}

async function pulseIdeas(community) {
  const base = { community, days: pulseState.days };
  const [ov, list] = await Promise.all([
    api(`/pulse/overview${qs(base)}`),
    api(`/pulse/discussions${qs({ ...base, kind: pulseState.kind === 'all' ? undefined : pulseState.kind, topic: pulseState.topic || undefined, status: pulseState.showDone ? undefined : 'active' })}`)
  ]);
  const t = ov.totals;
  const kindTab = (id, label) => html`<button class="${pulseState.kind === id ? 'active' : ''}" data-pulse="kind" data-kind="${id}">${label}</button>`;
  const column = (platform) => {
    const items = list.filter((d) => d.platform === platform);
    const has = communitiesOf(platform).length > 0;
    return html`<div class="panel"><h2>${PLAT[platform]} <span>${items.length} shown</span></h2>
      ${items.length ? items.map(pulseRow)
        : html`<div class="empty">${has ? 'Nothing here for these filters.' : `No ${PLAT[platform]} community connected yet.`}</div>`}</div>`;
  };
  return html`
    <div class="grid">
      <div class="card accent"><div class="num">${num(t.ideas)}</div><div class="lbl">Ideas shared</div></div>
      <div class="card ${t.openQuestions ? 'warn' : 'ok'}"><div class="num">${num(t.openQuestions)}</div><div class="lbl">Questions nobody answered</div></div>
      <div class="card ${t.concerns ? 'bad' : ''}"><div class="num">${num(t.concerns)}</div><div class="lbl">Concerns raised</div></div>
      <div class="card"><div class="num">${num(t.contributors)}</div><div class="lbl">People contributing</div></div>
    </div>
    ${ov.hotTopics.length > 0 && html`<div class="panel"><h2>What people are talking about <span>${pulseState.topic ? 'filtered by a topic' : 'click one to filter'}</span></h2>
      <div class="pad chips">
        ${pulseState.topic && html`<button class="chip on" data-pulse="topic" data-topic="">✕ ${pulseState.topic}</button>`}
        ${ov.hotTopics.map((h) => html`<button class="chip ${pulseState.topic === h.topic ? 'on' : ''}" data-pulse="topic" data-topic="${h.topic}">${h.topic} <b>${h.users}</b><i class="${h.sentiment < -0.2 ? 'neg' : h.sentiment > 0.2 ? 'pos' : ''}"></i></button>`)}
      </div></div>`}
    <div class="tabs filters">${kindTab('all', 'Everything')}${kindTab('idea', 'Ideas')}${kindTab('question', 'Questions')}${kindTab('concern', 'Concerns')}${kindTab('praise', 'Praise')}${kindTab('discussion', 'Discussions')}
      <label class="muted pcheck"><input type="checkbox" data-pulse-change="showdone" ${pulseState.showDone ? 'checked' : ''}> Show handled</label></div>
    <div class="split">${column('telegram')}${column('discord')}</div>
    ${ov.contributors.length > 0 && html`<div class="panel"><h2>Who is sharing <span>most active first</span></h2>
      ${ov.contributors.map((p) => html`<div class="row static"><div class="plat ${p.platform}">${CODE[p.platform]}</div>
        <div class="rowmain"><div class="who">${p.username}</div>
        <div class="txt">${p.ideas} ${p.ideas === 1 ? 'idea' : 'ideas'} · ${p.questions} ${p.questions === 1 ? 'question' : 'questions'} · ${p.concerns} ${p.concerns === 1 ? 'concern' : 'concerns'} · ${p.replies} replies received</div></div></div>`)}</div>`}
    <div class="muted" style="padding:4px 2px 16px">Pulse keeps ideas, questions and concerns for 30 days. Manage what it reads under <a data-nav="#/pulse/setup" style="cursor:pointer">Setup → Reading</a>.</div>`;
}

