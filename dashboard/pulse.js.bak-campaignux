const P_PRI = { high: 'bad', medium: 'net', low: '' };

async function pulsePlaybook(community) {
  const pb = await api(`/pulse/playbook${qs({ community, days: pulseState.days })}`);
  if (!pb.items.length) {
    return html`${pb.notice && html`<div class="panel"><div class="pad muted">${pb.notice}</div></div>`}
      <div class="panel"><div class="empty"><b>Nothing to suggest yet</b><br>The playbook fills in as your chats are read and the feeds bring in stories. Check the Trends tab to see whether the feeds are working.</div></div>`;
  }
  pulseState.playbook = pb.items;
  return html`
    ${pb.notice && html`<div class="panel"><div class="pad muted">${pb.notice}</div></div>`}
    
    ${pb.items.map((it, i) => html`<div class="panel"><h2>${it.title} <span><span class="tag ${P_PRI[it.priority]}">${it.priority} priority</span></span></h2>
      <div class="pad">
        <p style="margin:0 0 10px">${it.why}</p>
        <b>What to do</b>
        <ul class="plist">${it.actions.map((a) => html`<li>${a}</li>`)}</ul>
        <b>Draft post <span class="muted">(edit before you use it)</span></b>
        <textarea id="pd-${i}" class="pdraft" rows="${Math.min(9, it.draft.split('\n').length + 2)}">${it.draft}</textarea>
        <div style="display:flex;gap:8px;margin-top:8px;align-items:center;flex-wrap:wrap">
          <button class="btn primary" data-pulse="post" data-i="${i}">Post…</button>
          <button class="btn" data-pulse="copy" data-i="${i}">Copy draft</button>
          <span class="muted">Good for: ${it.channels.map((c) => (c === 'x' ? 'X' : PLAT[c])).join(', ')}</span></div>
        ${(it.evidence.discussions.length > 0 || it.evidence.trends.length > 0 || it.evidence.pools?.length > 0) && html`<details class="pev"><summary>Why this was suggested</summary>
          ${it.evidence.discussions.map((d) => html`<div class="pmeta"><span class="plat ${d.platform}" style="display:inline-flex;width:20px;height:20px;font-size:9px">${CODE[d.platform]}</span> <b>${d.username}</b>: ${d.text}</div>`)}
          ${it.evidence.trends.map((t) => html`<div class="pmeta"><span class="tag">${t.source}</span> <a href="${safeUrl(t.url)}" target="_blank" rel="noopener noreferrer">${t.title}</a></div>`)}
          ${(it.evidence.pools || []).map((x) => html`<div class="pmeta"><span class="tag info">Pool</span> ${x.text} ${x.url && html`<a href="${safeUrl(x.url)}" target="_blank" rel="noopener noreferrer">Source</a>`}</div>`)}
        </details>`}
      </div></div>`)}`;
}

