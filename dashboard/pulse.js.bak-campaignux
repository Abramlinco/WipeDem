      <div class="pad"><div class="srcform">
        <select id="xw-type"><option value="xaccount">An X account</option><option value="x">A search</option></select>
        <input id="xw-value" placeholder="e.g. osmosiszone, or: liquid staking airdrop">
        <button class="btn primary" data-pulse="x-watch-add" ${where}>Add</button></div>
        <div class="muted" style="margin-top:6px">Each one is read every ${x.everyHours} hours and counts towards the monthly limit above.</div></div>
    </div>
    <div class="panel"><h2>Post to X from Sentinel <span>${x.account.connected ? `connected as @${x.account.handle}` : 'not connected'}</span></h2><div class="pad">
      ${x.account.connected ? html`
        <div class="muted" style="margin-bottom:12px">Posts you approve can go to @${x.account.handle}. Each costs about $${x.costs.post.toFixed(3)}, or $${x.costs.postWithLink.toFixed(2)} if it contains a link, and Sentinel shows the cost before you post. The bill goes to the X developer account that owns these keys.</div>
        <button class="btn ban" data-pulse="x-disconnect" ${where}>Disconnect</button>`
        : html`
